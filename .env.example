# DeepSeek-compatible API settings. Never commit the real key.
R1999_API_KEY=
R1999_BASE_URL=https://api.deepseek.com
R1999_MODEL=deepseek-flash

# Use adb from PATH, or set the full path to your emulator's adb executable.
R1999_ADB_PATH=adb
R1999_ADB_SERIAL=127.0.0.1:16384

# Safety and runtime controls.
R1999_DRY_RUN=true
R1999_ENABLE_OCR=true
R1999_STEP_DELAY_SECONDS=2.0
R1999_MAX_STEPS=100
R1999_ARTIFACT_DIR=artifacts
